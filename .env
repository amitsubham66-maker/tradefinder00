# =========================================
# SERVER CONFIG
# =========================================

PORT=5000

NODE_ENV=development

# =========================================
# JWT SECURITY
# =========================================

JWT_SECRET=TRADEFINDER_AI_SECRET_2026_ULTRA_SECURE

JWT_EXPIRE=7d

# =========================================
# MONGODB DATABASE
# =========================================

MONGO_URI=mongodb://127.0.0.1:27017/tradefinder_ai

# =========================================
# REDIS CACHE
# =========================================

REDIS_URI=redis://127.0.0.1:6379

# =========================================
# NSE MARKET CONFIG
# =========================================

NSE_BASE_URL=https://www.nseindia.com

NSE_OPTION_CHAIN=https://www.nseindia.com/api/option-chain-indices

NSE_EQUITY_API=https://www.nseindia.com/api/equity-stockIndices

# =========================================
# AI ENGINE CONFIG
# =========================================

AI_ENGINE_URL=http://127.0.0.1:8000

AI_MODEL_VERSION=v1.0

AI_SIGNAL_THRESHOLD=0.75

# =========================================
# WEBSOCKET CONFIG
# =========================================

SOCKET_PORT=5001

SOCKET_RECONNECT=true

SOCKET_TIMEOUT=60000

# =========================================
# RATE LIMITING
# =========================================

RATE_LIMIT_WINDOW=60000

RATE_LIMIT_MAX=500

# =========================================
# ZERODHA API
# =========================================

ZERODHA_API_KEY=YOUR_ZERODHA_API_KEY

ZERODHA_API_SECRET=YOUR_ZERODHA_SECRET

ZERODHA_REDIRECT_URL=http://localhost:5000/auth/zerodha/callback

# =========================================
# UPSTOX API
# =========================================

UPSTOX_API_KEY=YOUR_UPSTOX_API_KEY

UPSTOX_API_SECRET=YOUR_UPSTOX_SECRET

# =========================================
# FYERS API
# =========================================

FYERS_APP_ID=YOUR_FYERS_APP_ID

FYERS_SECRET_ID=YOUR_FYERS_SECRET_ID

# =========================================
# ANGELONE API
# =========================================

ANGELONE_API_KEY=YOUR_ANGELONE_API_KEY

ANGELONE_CLIENT_CODE=YOUR_CLIENT_CODE

ANGELONE_PASSWORD=YOUR_PASSWORD

# =========================================
# OPENAI CONFIG
# =========================================

OPENAI_API_KEY=YOUR_OPENAI_KEY

# =========================================
# EMAIL ALERTS
# =========================================

EMAIL_HOST=smtp.gmail.com

EMAIL_PORT=587

EMAIL_USER=your_email@gmail.com

EMAIL_PASS=your_email_password

# =========================================
# LOGGING
# =========================================

LOG_LEVEL=debug

# =========================================
# TRADING SETTINGS
# =========================================

DEFAULT_RISK_PERCENT=1

MAX_DAILY_LOSS=5

AUTO_TRADING=false

PAPER_TRADING=true

# =========================================
# AI MODEL SETTINGS
# =========================================

LSTM_ENABLED=true

TRANSFORMER_ENABLED=true

RL_ENABLED=true

CNN_ENABLED=true

# =========================================
# CACHE SETTINGS
# =========================================

CACHE_MARKET_DATA=true

CACHE_DURATION=60

# =========================================
# SECURITY
# =========================================

ENABLE_HELMET=true

ENABLE_CORS=true

ENABLE_ENCRYPTION=true